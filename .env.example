# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- CORS: URL(s) del frontend React, separadas por coma ----
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecohome
DB_PASS=ecohome_pass
DB_NAME=ecohome

# ---- JWT ----
# Use una cadena larga y aleatoria. Ejemplo para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# ---- Usuario administrador inicial (lo crea `npm run db:seed`) ----
ADMIN_NAME="Administrador EcoHome"
ADMIN_EMAIL=admin@ecohome.com
ADMIN_PASSWORD=Admin12345!

# ---- Contraseña de las cuentas de demostración del chat (ventas / logistica / soporte) ----
STAFF_PASSWORD=Equipo12345!
